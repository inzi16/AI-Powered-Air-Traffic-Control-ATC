# Development defaults are localhost-only. Production refuses to start without
# a non-empty ATC_API_KEY.
ATC_ENV=development
ATC_API_KEY=
ATC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATC_ALLOWED_HOSTS=localhost,127.0.0.1
ATC_ENABLE_SIMCONNECT=false
ATC_ENABLE_DEV_ENDPOINTS=false
ATC_HOST=127.0.0.1
ATC_PORT=8000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
