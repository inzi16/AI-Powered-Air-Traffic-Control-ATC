# Development defaults are localhost-only. Never place real credentials in an
# example file. Production refuses to start without a non-empty ATC_API_KEY;
# operators must generate a unique secret of at least 32 random bytes.
ATC_ENV=development
ATC_API_KEY=
ATC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATC_ALLOWED_HOSTS=localhost,127.0.0.1
ATC_ENABLE_SIMCONNECT=false
ATC_ENABLE_DEV_ENDPOINTS=false
ATC_MAX_TRAINING_SESSIONS=25
ATC_SESSION_IDLE_SECONDS=3600
ATC_SESSION_MAX_IDLE_SECONDS=86400
ATC_MAX_WS_CLIENTS_PER_SESSION=8
ATC_MAX_COMMANDS_PER_SESSION=500
ATC_HOST=127.0.0.1
ATC_PORT=8000
# Keep the model service on a trusted private interface.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_HTTP_TIMEOUT_SECONDS=45
