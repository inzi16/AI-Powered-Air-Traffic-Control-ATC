.git
.github
.gitignore
.gitattributes
.editorconfig

# Never send credentials or local configuration into a Docker build context.
.env
.env.*
**/.env
**/.env.*
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
**/id_rsa
**/id_ed25519
**/credentials.json
**/secrets.json

# Local runtimes, caches, logs, coverage, and generated output.
.venv
.runtime
.verify-runtime
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
**/__pycache__
**/*.py[cod]
**/*.log
frontend/node_modules
frontend/.vite-cache
frontend/dist
frontend/*.tsbuildinfo

# Repository-only material is not required by either runtime image.
benchmarks
contracts
docs
scripts
audit-current
design-qa
design-reference
RESUME.md

.DS_Store
Thumbs.db
