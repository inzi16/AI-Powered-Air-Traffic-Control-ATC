root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,ts,tsx,js,mjs,json,yml,yaml,md,css,html}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[*.{png,woff2}]
insert_final_newline = false
trim_trailing_whitespace = false
