# Copy this file to .env.production, which is ignored by Git. Never commit the
# populated copy. Leave the key blank until deployment so fail-closed startup
# cannot accidentally use a known example credential.
ATC_ENV=production
ATC_API_KEY=
ATC_ALLOWED_HOSTS=atc.example.com
ATC_ALLOWED_ORIGINS=https://atc.example.com
ATC_ENABLE_SIMCONNECT=false
ATC_ENABLE_DEV_ENDPOINTS=false
ATC_MAX_TRAINING_SESSIONS=25
ATC_SESSION_IDLE_SECONDS=3600
ATC_SESSION_MAX_IDLE_SECONDS=86400
ATC_MAX_WS_CLIENTS_PER_SESSION=8
ATC_MAX_COMMANDS_PER_SESSION=500
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_HTTP_TIMEOUT_SECONDS=45
