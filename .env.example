ATC_ENV=development
ATC_HOST=127.0.0.1
ATC_PORT=8000
ATC_ALLOWED_HOSTS=localhost,127.0.0.1
ATC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required when ATC_ENV=production.
ATC_API_KEY=replace-with-a-long-random-secret

# Windows/MSFS only. Demo mode is the default.
ATC_ENABLE_SIMCONNECT=false

# Local AI service. The deterministic runtime keeps working when unavailable.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
