ATC_ENV=development
ATC_HOST=127.0.0.1
ATC_PORT=8000
ATC_ALLOWED_HOSTS=localhost,127.0.0.1
ATC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep empty for local development. Production refuses to start while empty;
# generate a unique 32-byte-or-longer secret at deployment time.
ATC_API_KEY=
ATC_ENABLE_DEV_ENDPOINTS=false

# Windows/MSFS only. Demo mode is the default.
ATC_ENABLE_SIMCONNECT=false

# Local model service. Do not expose it directly to untrusted networks.
# The deterministic runtime keeps working when it is unavailable.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_HTTP_TIMEOUT_SECONDS=45
